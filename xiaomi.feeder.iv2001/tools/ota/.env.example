# Copy to .env and edit for your bench (tools/ota/.env is gitignored).
# Sourced automatically by tools/ota/*.sh; does not override env already set.

export MQTT_HOST="${MQTT_HOST:-127.0.0.1}"
export MQTT_PORT="${MQTT_PORT:-1883}"
export MQTT_USER="${MQTT_USER:-petfeeder-flasher}"
export MQTT_PASS="${MQTT_PASS:-petfeeder}"
