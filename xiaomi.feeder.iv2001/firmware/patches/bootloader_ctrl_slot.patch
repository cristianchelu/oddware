diff --git a/project/mt7682_hdk/apps/bootloader/GCC/Makefile b/project/mt7682_hdk/apps/bootloader/GCC/Makefile
index f9a1a349..c4b8e2a1 100644
--- a/project/mt7682_hdk/apps/bootloader/GCC/Makefile
+++ b/project/mt7682_hdk/apps/bootloader/GCC/Makefile
@@ -77,6 +77,7 @@ ifeq ($(MTK_FOTA_DUAL_IMAGE_ENABLE),y)
 CFLAGS += -DMTK_FOTA_DUAL_IMAGE_ENABLE
 C_FILES += $(APP_PATH)/src/bl_dual_image.c
 C_FILES += $(APP_PATH)/src/boot_bank.c
+C_FILES += $(APP_PATH)/src/bl_boot_ctrl.c
 endif
 
 ifeq ($(MTK_FOTA_ENABLE),y)
diff --git a/project/mt7682_hdk/apps/bootloader/GCC/bootloader.ld b/project/mt7682_hdk/apps/bootloader/GCC/bootloader.ld
index 6e2b8b1a..a9f3c4d2 100644
--- a/project/mt7682_hdk/apps/bootloader/GCC/bootloader.ld
+++ b/project/mt7682_hdk/apps/bootloader/GCC/bootloader.ld
@@ -18,6 +18,7 @@ MEMORY
 {
   TCM (rwx)    : ORIGIN = 0x04008000, LENGTH = 64K
   SYSRAM (rwx) : ORIGIN = 0x04200000, LENGTH = 384K
+  /* IV2001: code below 0x0800F000; A/B ctrl in last 4 KB of BL region */
   ROM_BL(rx)   : ORIGIN = 0x08002000, LENGTH = 64K
 }
 
@@ -127,4 +128,11 @@ SECTIONS
     *(.rom_data*)        /* .rom_data* sections (constants, strings, etc.) */
     . = ALIGN(4);
   } > ROM_BL
+
+  .boot_ctrl 0x0800F000 :
+  {
+    . = ALIGN(4);
+    KEEP(*(.boot_ctrl))
+    . = ALIGN(4);
+  } > ROM_BL
 }
