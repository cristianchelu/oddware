+void lwip_sta_prepare_connect(void)
+{
+    struct netif *sta_if;
+
+    sta_if = netif_find_by_type(NETIF_TYPE_STA);
+    if (sta_if == NULL) {
+        return;
+    }
+
+    if (dhcp_config_init() == STA_IP_MODE_DHCP) {
+        dhcp_release(sta_if);
+        dhcp_stop(sta_if);
+        netif_set_addr(sta_if, IP4_ADDR_ANY, IP4_ADDR_ANY, IP4_ADDR_ANY);
+        if (ip_ready != NULL) {
+            while (xSemaphoreTake(ip_ready, 0) == pdTRUE) {
+                /* drain stale DHCP-ready posts */
+            }
+        }
+        dhcp_start(sta_if);
+    }
+
+    if (wifi_connected != NULL) {
+        while (xSemaphoreTake(wifi_connected, 0) == pdTRUE) {
+            /* drain stale link-up posts */
+        }
+    }
+}
+
+uint8_t lwip_net_link_ready_timeout(uint32_t timeout_ms)
+{
+    TickType_t ticks = pdMS_TO_TICKS(timeout_ms);
+
+    if (xSemaphoreTake(wifi_connected, ticks) != pdTRUE) {
+        return 0;
+    }
+    return 1;
+}
+
+uint8_t lwip_net_dhcp_ready_timeout(uint32_t timeout_ms)
+{
+    TickType_t ticks = pdMS_TO_TICKS(timeout_ms);
+
+    if (dhcp_config_init() == STA_IP_MODE_DHCP) {
+        if (xSemaphoreTake(ip_ready, ticks) != pdTRUE) {
+            return 0;
+        }
+    }
+    return 1;
+}
