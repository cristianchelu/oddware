# LinkIt SDK — fetched by tools/fetch-sdk.sh, never committed to git
external/

# Local SDK patch sync stamp (tools/sync-sdk-patches.sh)
.sdk-patches-stamp

# Session summaries (local memory, not committed)
summaries/

# OTA bench (tools/ota/)
tools/ota/.env
tools/ota/logs/
tools/ota/logs/.uart-*.lock

# Build output
*.bin
*.elf
*.hex
*.map
*.o
*.d
*.dis
build/
build-host/
out/

# KiCad backups
*-backups/
*.kicad_prl

# Editor/IDE (commit agent rules; keep plans local)
.cursor/*
!.cursor/
!.cursor/rules/
!.cursor/rules/**
.vscode/
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# Web UI — generated at build time (tools/web/build.sh)
firmware/src/web_ui_gz.c
tools/web/.web_ui_bundle.gz
tools/web/.web_ui_bundle.html
tools/web/.logic.inline.js
